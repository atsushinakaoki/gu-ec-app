# tech0 12期 共有 MySQL サーバーの接続情報。
# このファイルを .env としてプロジェクト直下（gu-ec-app/.env）にコピーし、
# パスワードを記入する。
#
# .env は .gitignore により GitHub に上がらない。
# 絶対にコミットしないこと。

DB_HOST=gen12-mysql-pos.mysql.database.azure.com
DB_USER=tech0
DB_PASSWORD='ここにSlackで共有されたパスワードを貼る'
DB_PORT=3306

# 共有サーバーのため、自分専用のデータベース名とする
DB_NAME=gu_ec_nakaoki

# Azure Database for MySQL は SSL 必須
DB_SSL=on
